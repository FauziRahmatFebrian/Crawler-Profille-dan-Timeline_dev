# ============================================================
# Instagram Crawler — Environment Variables (.env)
# Salin file ini menjadi .env lalu isi nilai yang sesuai:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# ============================================================

# ------------------------------------------------------------
# Instagram Session
# Ambil dari cookie "sessionid" setelah login di browser.
# Cara: login IG di browser → F12 → Application/Storage →
# Cookies → https://www.instagram.com → cari "sessionid".
# ------------------------------------------------------------
# SESSIONID untuk crawler hashtag (Training/hastag.py)
IG_SESSIONID_MAIN=your_instagram_sessionid_here
# SESSIONID untuk crawler profil (Training/profille.py)
IG_SESSIONID_PROFILLE=your_instagram_sessionid_here
# SESSIONID untuk trending discovery (Training/trending.py)
IG_SESSIONID=your_instagram_sessionid_here

# ------------------------------------------------------------
# ChromeDriver (dibutuhkan Training/hastag.py)
# Path menuju chromedriver sesuai OS kamu.
# ------------------------------------------------------------
DRIVER_PATH_local=./chromedriver-win64/chromedriver.exe

# ------------------------------------------------------------
# Sumber Crawling
# ------------------------------------------------------------
# URL Instagram yang mau di-crawl (hastag.py). Contoh:
# START_URL=https://www.instagram.com/explore/tags/papua/
START_URL=
# Daftar hashtag langsung, pisahkan dengan koma (prioritas
# tertinggi di hastag.py). Contoh: #papua,#jakarta,#indonesia
HASTAG_URL=
# Daftar username profil yang mau di-crawl (profille.py),
# pisahkan dengan koma. Contoh: @user1,user2,user3
# Jika kosong, diambil dari tabel ref_crawler_source di MySQL.
CRAWL_PROFILE_LIST=

# ------------------------------------------------------------
# Konfigurasi Crawling
# ------------------------------------------------------------
# Jumlah postingan yang di-crawl per hashtag / per akun
MAX_POSTS=5
# Jumlah komentar per postingan
MAX_COMMENTS=50

# ------------------------------------------------------------
# Output
# ------------------------------------------------------------
# Nama file output untuk hastag.py
OUTPUT_VOCAB_CSV_post=output_posts.csv
OUTPUT_JSON_post=output_posts.json
OUTPUT_VOCAB_CSV=vocab.csv
# Folder tempat gambar (wordcloud) disimpan
IMAGE_DIR=downloaded_images
WORDCLOUD_PATH_post=downloaded_images/output/wordcloud_post.png
# Label akun yang melakukan crawl (muncul di ES sebagai account_for_crawl)
USER=

# ------------------------------------------------------------
# Proxy (opsional — dipakai profille.py & hastag.py)
# ------------------------------------------------------------
# Proxy langsung, contoh: http://user:pass@ip:port
PROXY_URL=
# Proxy untuk profil crawler (profille.py)
PROXY_USER_MAIN=
PROXY_PASS_MAIN=
PROXY_IP_MAIN=
PROXY_PORT_MAIN=

# ------------------------------------------------------------
# MySQL
# Kredensial "masuk" dipakai function/db.py
# (penyimpanan komentar/postingan ke tabel comments & posts).
# ------------------------------------------------------------
MYSQL_HOST_masuk=localhost
MYSQL_USER_masuk=root
MYSQL_PASS_masuk=
MYSQL_DB_masuk=crawler_instagram

# Kredensial standar (dipakai hastag.py & profille.py untuk
# mengambil daftar hashtag/akun dari ref_crawler_source).
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=crawler_instagram

# ------------------------------------------------------------
# Elasticsearch
# ------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# ------------------------------------------------------------
# Telegram (notifikasi hasil crawling)
# ------------------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# AI / Model (opsional)
# ------------------------------------------------------------
# API key Gemini untuk klasifikasi topik (topic_clasification.py)
GEMINI_API_KEY=
